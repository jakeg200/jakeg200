# Postgres for development; the default is a local sqlite file so a fresh clone runs.
WARRANT_DATABASE_URL=postgresql+psycopg://warrant:warrant@localhost:5432/warrant

# LLM wrapper: live | replay | off.
# replay is the default and reads recorded fixtures, falling back to the deterministic
# pipeline on a miss. The eval harness and CI therefore need no key.
WARRANT_LLM_MODE=replay
WARRANT_LLM_MODEL=claude-sonnet-4-6
# WARRANT_RECORD_FIXTURES=true   # with llm_mode=live, write every response to evals/fixtures
# ANTHROPIC_API_KEY=...

# Tier 2. Off by default; build the image with `make lean-image` first.
WARRANT_LEAN_ENABLED=false
WARRANT_LEAN_TIMEOUT_S=20

# Records are signed by warrant and held by the learner. With no key set, a deterministic
# development key is used and the record says so.
# WARRANT_SIGNING_KEY_HEX=<64 hex chars>
